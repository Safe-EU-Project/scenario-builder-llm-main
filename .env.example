# Scenario Builder Service Configuration
SERVICE_PORT=8002
LOG_LEVEL=INFO

# Data Folder Configuration
DATA_FOLDER=./data

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
COLLECTION_NAME=scenarios
EMBEDDING_DIM=384

# Storage Configuration
METADATA_DB_PATH=./data/scenario_metadata.db

# Embedding Configuration
EMBEDDING_PROVIDER=sentence_transformer
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Document Processing Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CHUNK_SIZE=2000

# Retrieval Configuration
DEFAULT_TOP_K=5
MAX_TOP_K=20
RETRIEVAL_ALPHA=0.7

# LLM Configuration (OpenAI-compatible /v1/chat/completions endpoint)
LLM_API_URL=http://10.240.138.254:11434/v1/chat/completions
LLM_MODEL=llama2
LLM_TEMPERATURE=0.7
LLM_SEED=42
LLM_STREAM=false
